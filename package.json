{
  "name": "kiro-account-lite",
  "version": "1.0.21",
  "description": "Kiro Manager Lite - Kiro 多账号管理器轻量版",
  "main": "./out/main/index.js",
  "author": "kiro-account-lite",
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "clean": "node scripts/clean.mjs",
    "prepack:dist": "npm run clean && electron-vite build",
    "build:mac": "npm run prepack:dist && electron-builder --mac",
    "build:win": "npm run prepack:dist && electron-builder --win",
    "build:linux": "npm run prepack:dist && electron-builder --linux",
    "build:all": "npm run prepack:dist && electron-builder --mac --win --linux",
    "build:unpack": "npm run prepack:dist && electron-builder --dir"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "cbor-x": "1.6.0",
    "electron-store": "8.2.0",
    "undici": "7.13.0"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@types/node": "22.13.10",
    "@vitejs/plugin-vue": "5.2.3",
    "ant-design-vue": "4.2.6",
    "chalk": "5.4.1",
    "dayjs": "1.11.13",
    "dompurify": "3.4.12",
    "electron": "35.7.5",
    "electron-builder": "25.1.8",
    "electron-vite": "3.1.0",
    "marked": "18.0.7",
    "pinia": "3.0.1",
    "terser": "5.39.0",
    "typescript": "5.8.2",
    "unplugin-vue-components": "^32.1.0",
    "uuid": "11.1.0",
    "vite": "6.2.6",
    "vite-plugin-html": "3.2.2",
    "vue": "3.5.13",
    "vue-router": "4.5.0",
    "vue-tsc": "2.2.8"
  }
}
