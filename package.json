{
  "name": "kiro-account-lite",
  "version": "1.0.38",
  "description": "Kiro Manager Lite - Kiro 多账号管理器轻量版",
  "main": "./out/main/index.js",
  "author": "kiro-account-lite",
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:cli-sync": "node --test tests/kiroCliAuth.test.mjs",
    "clean": "node scripts/clean.mjs",
    "prepack:dist": "npm run clean && electron-vite build",
    "build:mac": "npm run prepack:dist && node scripts/build-mac.mjs",
    "build:win": "npm run prepack:dist && electron-builder --win",
    "build:linux": "npm run prepack:dist && electron-builder --linux",
    "build:all": "npm run prepack:dist && electron-builder --mac --win --linux",
    "build:unpack": "npm run prepack:dist && electron-builder --dir"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "cbor-x": "1.6.6",
    "electron-store": "12.0.0",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/devtools-api": "8.2.1",
    "ant-design-vue": "4.2.6",
    "chalk": "6.0.1",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "marked": "18.1.1",
    "pinia": "4.0.3",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "7.3.7",
    "vite-plugin-html": "3.2.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
